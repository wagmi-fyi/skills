# QuickBooks Online API Credentials
# Copy this file to your project: .claude/qbo/.env

# OAuth 2.0 App Credentials (from Intuit Developer Portal)
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=

# OAuth Tokens (from OAuth 2.0 Playground or your auth flow)
QBO_ACCESS_TOKEN=
QBO_REFRESH_TOKEN=

# Company/Realm ID (visible in QBO URL after /app/)
QBO_REALM_ID=

# Environment: 'sandbox' or 'production'
QBO_ENVIRONMENT=production
